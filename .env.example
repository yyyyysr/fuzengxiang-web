# 复制为 .env 后填写。未填写 LLM_API_KEY 时，小傅以“资料检索摘编”模式回答（仍带出处）。

# OpenAI 兼容的对话接口（DeepSeek / 通义千问 / Kimi / GLM / OpenAI 等均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 知识库位置（默认 ../藏书家智能体/knowledge_base）
# KB_ROOT=D:\DevFiles\lamblamb\sys-manage\藏书家智能体\knowledge_base

# 向量检索：1 启用（需要 data/index/embeddings.npy 与 data/index/onnx/，依赖 onnxruntime、tokenizers），0 关闭
ENABLE_DENSE=1

# 服务端口
PORT=8000

# 知识库后台（/admin/wiki）的管理口令；不填则后台停用
# ADMIN_TOKEN=
# 后台写入记录的保存目录（默认 知识库/data/admin）
# ADMIN_DATA=
